# Next.js (BFF) -> Flask. Para desenvolvimento com ambos no host, prefira
# 127.0.0.1 para evitar que "localhost" seja resolvido como IPv6 (::1).
API_URL=http://127.0.0.1:5000
API_TIMEOUT_MS=10000

# Se o frontend também estiver em um container na mesma rede Docker:
# API_URL=http://api:5000

# URL do formulário/CRM que receberá as solicitações de demonstração.
# NEXT_PUBLIC_DEMO_REQUEST_URL=
